{
  "name": "my-next-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:http": "playwright test tests/e2e/template-security-http.playwright.ts --project=desktop",
    "verify:rendering": "node --experimental-strip-types tests/rendering/verify-rendering.ts",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run && next build && node --experimental-strip-types tests/rendering/verify-rendering.ts",
    "test:consumer": "node --experimental-strip-types tests/consumer/validate-template.ts",
    "audit": "node --experimental-strip-types scripts/audit.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "simple-icons": "16.36.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "js-yaml": "4.3.2",
    "minimatch@>=7 <11.0.1": "11.0.4",
    "nanoid": "3.3.20",
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "sharp",
    "unrs-resolver"
  ],
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
